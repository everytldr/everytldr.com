# Copy this file to .env and fill secrets locally.
# Do not commit .env.
# These values are local-development defaults only.
# Production and staging environments must use different secrets.

# MySQL application datasource
DB_URL=jdbc:mysql://localhost:3306/everytldr?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=everytldr
DB_PASSWORD=everytldr

# JPA and Flyway
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Snowflake ID generator
# Runtime worker IDs should use 0..1022. Worker ID 1023 is reserved for Flyway reference data.
APP_WORKER_ID=0

# Ingestor scheduler
INGESTION_ENABLED=false
INGESTION_FIXED_DELAY=15m

# Enricher DB-only processing scheduler
ENRICHER_PROCESSING_ENABLED=false
ENRICHER_PROCESSING_BATCH_SIZE=10
ENRICHER_PROCESSING_FIXED_DELAY=30s
ENRICHER_PROCESSING_MAX_ATTEMPTS=3
ENRICHER_PROCESSING_RETRY_DELAY=10m
ENRICHER_PROCESSING_STALE_TIMEOUT=15m

# Enricher source-aware content resolver
ENRICHER_CONTENT_ALLOWED_HOSTS=globalvoices.org,www.globalvoices.org
ENRICHER_CONTENT_REQUEST_TIMEOUT=5s
ENRICHER_CONTENT_MAX_REDIRECTS=3
ENRICHER_CONTENT_MAX_BODY_BYTES=1048576
ENRICHER_CONTENT_MIN_BODY_CHARS=200

# Enricher category option cache
ENRICHER_CACHE_CATEGORY_OPTIONS_TTL=5m

# Enricher Gemini API client
ENRICHER_AI_GEMINI_ENABLED=false
ENRICHER_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
ENRICHER_AI_GEMINI_MODEL=gemini-3.1-flash-lite
ENRICHER_AI_GEMINI_REQUEST_TIMEOUT=30s
ENRICHER_AI_GEMINI_PROMPT_RESOURCE=classpath:prompts/article-enrichment-system-prompt.txt
