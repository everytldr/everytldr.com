# Copy this file to .env and fill secrets locally.
# Do not commit .env.
# These values are local-development defaults only.
# Production and staging environments must use different secrets.

# MySQL application datasource
DB_URL=jdbc:mysql://localhost:3306/everytldr?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=everytldr
DB_PASSWORD=everytldr

# MySQL local docker compose settings
MYSQL_DATABASE=everytldr
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# JPA and Flyway
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Snowflake ID generator
# Runtime worker IDs should use 0..1022. Worker ID 1023 is reserved for Flyway reference data.
APP_WORKER_ID=0

# Guardian Open Platform
GUARDIAN_BASE_URL=https://content.guardianapis.com
GUARDIAN_API_KEY=
GUARDIAN_PAGE_SIZE=20

# Ingestor scheduler
INGESTION_ENABLED=false
INGESTION_FIXED_DELAY=15m
